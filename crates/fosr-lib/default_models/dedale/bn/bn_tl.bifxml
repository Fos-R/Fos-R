<VARIABLE TYPE="nature">
	<NAME>Applicative Proto</NAME>
	<PROPERTY>description = Applicative Proto</PROPERTY>
	<PROPERTY>fast = Applicative Proto{dce_rpc|dce_rpc,gssapi,krb|dhcp|dns|gssapi,krb,smb|http|ldap_tcp|ldap_udp|ntp|quic,ssl|smtp,ssl|ssl}</PROPERTY>
<!--OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility-->
	<OUTCOME>dce_rpc</OUTCOME>
	<OUTCOME>dce_rpc,gssapi,krb</OUTCOME>
	<OUTCOME>dhcp</OUTCOME>
	<OUTCOME>dns</OUTCOME>
	<OUTCOME>gssapi,krb,smb</OUTCOME>
	<OUTCOME>http</OUTCOME>
	<OUTCOME>ldap_tcp</OUTCOME>
	<OUTCOME>ldap_udp</OUTCOME>
	<OUTCOME>ntp</OUTCOME>
	<OUTCOME>quic,ssl</OUTCOME>
	<OUTCOME>smtp,ssl</OUTCOME>
	<OUTCOME>ssl</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Proto</NAME>
	<PROPERTY>description = Proto</PROPERTY>
	<PROPERTY>fast = Proto{TCP|UDP}</PROPERTY>
<!--OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility-->
	<OUTCOME>TCP</OUTCOME>
	<OUTCOME>UDP</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Connection State</NAME>
	<PROPERTY>description = Connection State</PROPERTY>
	<PROPERTY>fast = Connection State{RST|S0|SF|SH|none}</PROPERTY>
<!--OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility-->
	<OUTCOME>RST</OUTCOME>
	<OUTCOME>S0</OUTCOME>
	<OUTCOME>SF</OUTCOME>
	<OUTCOME>SH</OUTCOME>
	<OUTCOME>none</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Cat Packet</NAME>
	<PROPERTY>description = Cat Packet</PROPERTY>
	<PROPERTY>fast = Cat Packet{cluster-000|cluster-001|cluster-002|cluster-003|cluster-004|cluster-005|cluster-006|cluster-007|cluster-008}</PROPERTY>
<!--OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility-->
	<OUTCOME>cluster-000</OUTCOME>
	<OUTCOME>cluster-001</OUTCOME>
	<OUTCOME>cluster-002</OUTCOME>
	<OUTCOME>cluster-003</OUTCOME>
	<OUTCOME>cluster-004</OUTCOME>
	<OUTCOME>cluster-005</OUTCOME>
	<OUTCOME>cluster-006</OUTCOME>
	<OUTCOME>cluster-007</OUTCOME>
	<OUTCOME>cluster-008</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Src IP Role</NAME>
	<PROPERTY>description = Src IP Role</PROPERTY>
	<PROPERTY>fast = Src IP Role{User}</PROPERTY>
<!--OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility-->
	<OUTCOME>User</OUTCOME>
</VARIABLE>

<VARIABLE TYPE="nature">
	<NAME>Dst IP Role</NAME>
	<PROPERTY>description = Dst IP Role</PROPERTY>
	<PROPERTY>fast = Dst IP Role{Internet|Server}</PROPERTY>
<!--OUTCOME are not used in pyAgrum BIFXML (see fast property) but are kept for compatibility-->
	<OUTCOME>Internet</OUTCOME>
	<OUTCOME>Server</OUTCOME>
</VARIABLE>

